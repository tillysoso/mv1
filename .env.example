EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=

# Sentry error monitoring (tracker #146). Leave blank to disable — the SDK no-ops.
EXPO_PUBLIC_SENTRY_DSN=
# Native release builds: source-map / debug-symbol upload is wired in only when
# SENTRY_AUTH_TOKEN is set at build time (see app.config.js), together with
# SENTRY_ORG and SENTRY_PROJECT (build env / EAS secrets, never EXPO_PUBLIC_).
# Without them the build still succeeds and crash reporting still works, just
# with unsymbolicated stack traces.

# PostHog product analytics (tracker #147). Leave KEY blank to disable — the SDK no-ops.
# HOST is your PostHog region, e.g. https://us.i.posthog.com or https://eu.i.posthog.com.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
