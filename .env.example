EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=

# Sentry error monitoring (tracker #146). Leave blank to disable — the SDK no-ops.
EXPO_PUBLIC_SENTRY_DSN=
# Native release builds: the @sentry/react-native config plugin (app.json) uploads
# source maps and needs SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT at build time
# (build env / EAS secrets, never EXPO_PUBLIC_). Until those exist, set
# SENTRY_DISABLE_AUTO_UPLOAD=true or the upload step fails the build.
